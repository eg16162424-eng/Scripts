local function getEggs()
    local eggFolder = workspace:FindFirstChild(Config.StealEgg.EggFolder)
        or workspace:FindFirstChild("Eggs")
        or workspace:FindFirstChild("EggsFolder")
    if not eggFolder then return {} end
    local lista = {}
    for _, obj in ipairs(eggFolder:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then table.insert(lista, obj) end
    end
    return lista
end

local function getEggValue(egg)
    local valor = 0
    pcall(function()
        if egg:GetAttribute("Value") then valor = egg:GetAttribute("Value") end
        local v = egg:FindFirstChild("Value") or egg:FindFirstChild("Worth") or egg:FindFirstChild("Price")
        if v and v:IsA("NumberValue") then valor = v.Value end
    end)
    return valor
end

local function getBestEgg()
    local ovos = getEggs()
    local melhor, maiorValor = nil, -1
    for _, ovo in ipairs(ovos) do
        local v = getEggValue(ovo)
        if v > maiorValor then maiorValor = v; melhor = ovo end
    end
    return melhor, maiorValor
end

local function getEggPosition(egg)
    if egg:IsA("Model") then
        local p = egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart")
        return p and p.Position or nil
    elseif egg:IsA("BasePart") then
        return egg.Position
    end
    return nil
end

local function pegarOvo(egg)
    for _, d in ipairs(egg:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            pcall(function() fireproximityprompt(d) end)
        elseif d:IsA("ClickDetector") then
            pcall(function() fireclickdetector(d) end)
        end
    end
end

local function pegarMelhorPet()
    pcall(function()
        for _, r in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
            if r:IsA("RemoteEvent") and r.Name:lower():find("equip") then
                r:FireServer("Best")
            end
        end
    end)
end

