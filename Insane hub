local eggEspObjects = {}

local function getEggRarity(egg)
    local raridade = "Comum"
    pcall(function()
        if egg:GetAttribute("Rarity") then raridade = egg:GetAttribute("Rarity")
        elseif egg:GetAttribute("rarity") then raridade = egg:GetAttribute("rarity")
        else
            local r = egg:FindFirstChild("Rarity") or egg:FindFirstChild("rarity")
            if r and r:IsA("StringValue") then raridade = r.Value
            elseif r and r:IsA("NumberValue") then
                local mapa = {
                    [1] = "Comum", [2] = "Incomum", [3] = "Raro",
                    [4] = "Épico", [5] = "Lendário", [6] = "Mítico",
                    [7] = "Cósmico", [8] = "Divino", [9] = "Eterno", [10] = "Secreto"
                }
                raridade = mapa[r.Value] or "Comum"
            end
        end
    end)
    raridade = string.gsub(raridade, "^%l", string.upper)
    return raridade
end

local function criarEggESP(egg)
    local label = Drawing.new("Text")
    label.Size = 14; label.Center = true; label.Outline = true; label.Font = 2
    label.Text = ""; label.Color = Color3.fromRGB(255, 255, 255); label.Transparency = 1
    eggEspObjects[egg] = label
end

local function removerEggESP(egg)
    if eggEspObjects[egg] then
        eggEspObjects[egg]:Remove()
        eggEspObjects[egg] = nil
    end
end

task.spawn(function()
    while task.wait(1) do
        local eggFolder = workspace:FindFirstChild(Config.StealEgg.EggFolder)
            or workspace:FindFirstChild("Eggs")
            or workspace:FindFirstChild("EggsFolder")
        if not eggFolder then continue end
        for _, egg in ipairs(eggFolder:GetChildren()) do
            if (egg:IsA("Model") or egg:IsA("BasePart")) and not eggEspObjects[egg] then
                criarEggESP(egg)
            end
        end
        for egg, label in pairs(eggEspObjects) do
            if not egg.Parent then removerEggESP(egg) end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    for egg, label in pairs(eggEspObjects) do
        if not egg.Parent or not Config.EggESP.Enabled then
            label.Visible = false
            continue
        end
        local pos
        if egg:IsA("Model") then
            local p = egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart")
            pos = p and p.Position
        else
            pos = egg.Position
        end
        if not pos then label.Visible = false; continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
        if onScreen then
            label.Visible = true
            label.Position = Vector2.new(screenPos.X, screenPos.Y)
            if Config.EggESP.ShowRarity then
                local raridade = getEggRarity(egg)
                label.Text = egg.Name .. " [" .. raridade .. "]"
                label.Color = CORES_RARIDADE[raridade] or Color3.fromRGB(255, 255, 255)
            else
                label.Text = egg.Name
                label.Color = Color3.fromRGB(255, 255, 255)
            end
        else
            label.Visible = false
        end
    end
end)

